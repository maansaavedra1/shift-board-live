# Copy this file to .env and fill in real values before running
# `docker compose up --build`. Never commit the real .env file.

# --- Sprout HR sandbox/production credentials ---
SPROUT_BASE=https://gateway-sb.sprout.ph
SPROUT_CLIENT_ID=
SPROUT_CLIENT_SECRET=
SPROUT_SUBSCRIPTION_KEY=
SPROUT_USER_ID=

# --- Keycloak ---
# For local testing with the bundled `keycloak` service in docker-compose.yml,
# leave KEYCLOAK_URL as the internal Docker network address below.
# For a real deployment, point this at your production Keycloak instead
# (see AZURE_DEPLOYMENT.md).
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=shift-board
KEYCLOAK_CLIENT_ID=shift-board-app
# Optional — only set this if you configured an audience claim in Keycloak
KEYCLOAK_AUDIENCE=
# The realm role required to view the dashboard. A user can log into
# Keycloak successfully and still be denied (403) if they don't have this
# role assigned. Leave as "admin" to match shift-board-realm.json, or set
# to an empty string to disable the role check (any logged-in user allowed).
REQUIRED_ROLE=admin
