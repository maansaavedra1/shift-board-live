{
  "realm": "shift-board",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "shift-board-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "shift-board-admin-api",
      "enabled": true,
      "publicClient": false,
      "secret": "CHANGE_ME_LOCAL_TESTING_ONLY",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "description": "Used only by scripts/onboard-admin-user.js to create users and assign the admin role via Keycloak's Admin REST API — not used by the dashboard itself. Regenerate this client's secret in Keycloak's admin console before using outside local testing; never reuse the value shipped in this file."
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Grants access to the Shift Board dashboard. Assign this to a user's account (Users → their account → Role mapping → Assign role) to onboard them — creating the Keycloak account alone does not grant access."
      }
    ]
  },
  "users": [
    {
      "username": "service-account-shift-board-admin-api",
      "enabled": true,
      "serviceAccountClientId": "shift-board-admin-api",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    },
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "testuser-noaccess",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser-noaccess@example.com",
      "firstName": "Test",
      "lastName": "NoAccess",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ]
    }
  ]
}

