{
  "realm": "shift-board",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "shift-board-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Grants access to the Shift Board dashboard. Assign this to a user's account (Users → their account → Role mapping → Assign role) to onboard them — creating the Keycloak account alone does not grant access."
      }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "testuser-noaccess",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser-noaccess@example.com",
      "firstName": "Test",
      "lastName": "NoAccess",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ]
    }
  ]
}

